# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
ADMIN_CHAT_ID=123456789

# Default working directory (Optional, if empty bot will prompt on start)
DEFAULT_CWD=C:\Users\username\Desktop\my-project

# Default AI Model (gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.1-pro, claude-sonnet-4-6, claude-opus-4-6-thinking, gpt-oss-120b-medium)
DEFAULT_MODEL=gemini-3.8-flash

# Default Model Reasoning Speed / Effort (low, medium, high)
DEFAULT_EFFORT=high

# Display label only. This does not change AGY's network location or bypass regional availability.
# VPN_COUNTRY / VPN_COUNTRY_CODE override this label; the VPN app must route the OS/AGY traffic itself.
DEFAULT_COUNTRY=us
# VPN_COUNTRY=us

# Optional: set only if your AGY CLI version supports standard proxy environment variables.
# System-wide VPN routing is preferred; browser-only VPN extensions do not route AGY traffic.
# HTTPS_PROXY=http://127.0.0.1:8080
# HTTP_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1

# 5-Hour Limit (Default ceiling for requests in rolling 5-hour window)
FIVE_HOUR_LIMIT=250

# Local HTTP API Port for Telegram file/message callbacks
LOCAL_API_PORT=7799

# System Safety & Bypass Controls
# SAFE_MODE=true: Protects system settings, Antigravity IDE, and DNS from modifications
# ENABLE_SYSTEM_BYPASS=false: Disables automatic binary patching and NRPT/hosts modifications
SAFE_MODE=true
ENABLE_SYSTEM_BYPASS=false
